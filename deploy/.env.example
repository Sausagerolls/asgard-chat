# Copy to .env (setup.sh does this). .env is gitignored — never commit it.

ASGARD_DOMAIN=chat.giantmushroom.studio
LIVEKIT_DOMAIN=rtc.chat.giantmushroom.studio
ACME_EMAIL=admin@giantmushroom.studio
ASGARD_VERSION=dev
MAX_UPLOAD_MB=2048

# --- Media storage ---
# fs (default): encrypted blobs on the asgard_data Docker volume.
# s3: any S3-compatible bucket.
ASGARD_STORAGE=fs
# S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
# S3_BUCKET=asgard-media
# S3_REGION=eu-central-003
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Push notifications (optional but needed for background delivery) ---
# Put the APNs auth key in deploy/secrets/push/ (gitignored), then:
# APNS_KEY_FILE=/run/secrets/push/AuthKey_ABCDE12345.p8
# APNS_KEY_ID=ABCDE12345
# APNS_TEAM_ID=YOURTEAMID
APNS_TOPIC=com.giantmushroom.asgardchat
# true for Xcode debug builds, false for TestFlight/App Store
# FCM_CREDENTIALS_FILE=/run/secrets/push/fcm-service-account.json

# --- Backups (restic, encrypted) ---
# Local folder by default. Off-site examples:
#   RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/asgard
#   RESTIC_REPOSITORY=sftp:user@nas:/backups/asgard
BACKUP_DIR=./data/backups
BACKUP_HOUR=3
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# Local test server (docker-compose.lan.yml): this machine's Bonjour name
# LAN_HOST=My-Mac.local

# Push notifications for the official apps go through the Asgard push relay,
# which this server registers with automatically. Set to "off" to use only your
# own APNs/FCM keys (uploaded in the web admin), e.g. for apps you build yourself.
# ASGARD_PUSH_RELAY=https://push.giantmushroom.studio
